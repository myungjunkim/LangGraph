[rag]
base-url=http://127.0.0.1:5010
search-path=/v1/search
timeout=30
top-k=6

[ollama]
base-url=http://127.0.0.1:11434
llm-model=qwen3:14b
num-ctx=16384
temperature=0
llm-timeout=120

[agent]
recursion-limit=12

[fastapi]
host=127.0.0.1
port=5020

[checkpoint]
db-path=data/checkpoints.sqlite

[api-services]
general-chatbot-api=https://qa-general-chatbot-api.hunet.ai
message-api=https://message-api.qa.hunet.io

[api]
timeout=20
max-response-chars=2000
